# Copy to .env and fill these values only on the server or your own computer.
# The browser never needs the AI credentials.
CATAN_AI_BASE_URL=https://your-ai-provider.example/v1
CATAN_AI_MODEL=your-model-name
# Optional per-tier overrides; omitted tiers use CATAN_AI_MODEL.
# CATAN_AI_MODEL_MEDIUM=your-fast-model
# CATAN_AI_MODEL_HIGH=your-stronger-model
# CATAN_AI_MODEL_VERY_HIGH=your-stronger-model
# CATAN_AI_MODEL_HIGHEST=your-strongest-model
CATAN_AI_KEY=replace-with-your-private-key
CATAN_AI_TIMEOUT_MS=9000
